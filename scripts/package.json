{
  "name": "@workspace/scripts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "discovery:setup": "tsx ./src/discovery-coordination-setup.ts",
    "test:mcp-discovery": "tsx --test ../artifacts/api-server/src/lib/mcp-discovery.test.ts ../artifacts/api-server/src/lib/mcp-discovery.integration.test.ts",
    "enterprise-standards": "tsx ./src/enterprise-standards.ts",
    "test:enterprise": "tsx --test ../artifacts/api-server/src/lib/enterprise-auth.test.ts ./src/enterprise-integration.test.ts",
    "test:openmetadata": "tsx --test ./src/openmetadata.test.ts",
    "test:openmetadata-integration": "tsx --test ./src/openmetadata-integration.test.ts",
    "cloudflare-os:prepare": "node ./cloudflare-os/prepare.mjs",
    "cloudflare-os:serve": "node ./cloudflare-os/serve.mjs",
    "cloudflare-os:preview": "node ./cloudflare-os/serve.mjs --unsafe-trusted-preview",
    "cloudflare-os:production-check": "node ./cloudflare-os/production-check.mjs",
    "cloudflare-os:test": "node --test ./cloudflare-os/hosting.test.mjs",
    "hello": "tsx ./src/hello.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:"
  },
  "dependencies": {
    "@workspace/agent-runtime": "workspace:*",
    "@workspace/db": "workspace:*",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  }
}
